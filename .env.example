#---------------------------------------------------------rollerbed_tracking_db------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rollerbed_tracking_db
DB_USER=root
DB_PASSWORD=root

WS_SERVER_HOST=localhost
WS_SERVER_PORT=8082
WS_SERVER_PATH=/ws/emosweb
WS_USE_PORT_IN_URL=true

LOG_LEVEL=INFO
DEVICE_CONFIG_PATH=deviceConfig.json

#---------------------------------------------------------defect_db------------------------------
DEFECT_TARGET_DB_HOST=localhost
DEFECT_TARGET_DB_PORT=5432
DEFECT_TARGET_DB_NAME=defect_db
DEFECT_TARGET_DB_USER=root
DEFECT_TARGET_DB_PASSWORD=root

#---------------------------------------------------------carbody_history SQL Server Source------------------------------
# Source SQL Server
CARBODY_SOURCE_DB_HOST=
CARBODY_SOURCE_DB_PORT=1433
CARBODY_SOURCE_DB_NAME=DXQcontrol_SVWMEB_BI_DWH
CARBODY_SOURCE_DB_USER=sa
CARBODY_SOURCE_DB_PASSWORD=
CARBODY_SOURCE_DB_SCHEMA=dbo

# Target PostgreSQL (analytics_db)
CARBODY_TARGET_DB_HOST=localhost
CARBODY_TARGET_DB_PORT=5432
CARBODY_TARGET_DB_NAME=analytics_db
CARBODY_TARGET_DB_USER=root
CARBODY_TARGET_DB_PASSWORD=root

# carbody ODS incremental refresh configuration
CARBODY_REFRESH_LOCK_KEY=20260515
CARBODY_REFRESH_BATCH_SIZE=5000
CARBODY_REFRESH_LOG_LEVEL=INFO
CARBODY_REFRESH_TIMEZONE=Asia/Shanghai

#---------------------------------------------------------scheduler------------------------------
# 定时调度器的刷新时间间隔（单位：分钟）
SCHEDULER_INTERVAL_MINUTES=3
