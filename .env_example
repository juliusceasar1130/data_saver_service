# 更新时间：2026-04-13 18:05 Asia/Shanghai
# 主要修改内容：
# 1. 补充 defect_db 缺陷汇总增量刷新的 PostgreSQL target + SQL Server/PostgreSQL source 配置模板
# 2. 保留原有 WebSocket 与 rollerbed_tracking_db 示例配置
# 3. 补充 Docker Desktop 下 defect-refresh 容器的目标库主机覆盖参数

# 数据库连接配置 (用于原有 Python 程序)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rollerbed_tracking_db
DB_USER=root
DB_PASSWORD=root

# WebSocket 采集端配置 (用于 data_saver_service_v2.py)
WS_SERVER_HOST=172.21.12.73
# WS_SERVER_PORT=8088
WS_SERVER_PATH=/ws/emosweb
WS_USE_PORT_IN_URL=false

# 其他配置
LOG_LEVEL=INFO
DEVICE_CONFIG_PATH=deviceConfig.json

# defect_db 目标库配置
# 汇总结果始终写回本地 defect_db
DEFECT_TARGET_DB_HOST=localhost
DEFECT_TARGET_DB_PORT=5432
DEFECT_TARGET_DB_NAME=defect_db
DEFECT_TARGET_DB_USER=root
DEFECT_TARGET_DB_PASSWORD=root

# Docker Desktop 下的 defect-refresh 容器覆盖参数
# 仅用于 docker compose 中的 defect-refresh 服务，不影响宿主机直接执行脚本
DEFECT_TARGET_DB_HOST_IN_DOCKER=postgres
DEFECT_TARGET_DB_PORT_IN_DOCKER=5432

# defect_db 源库配置
# 如果全部留空，则回退为“源库 = 目标库(PostgreSQL)”
# 如果开始填写远程源库，请把必要字段全部补齐；否则脚本会直接报配置错误
DEFECT_SOURCE_DB_TYPE=
DEFECT_SOURCE_DB_HOST=
DEFECT_SOURCE_DB_PORT=
DEFECT_SOURCE_DB_NAME=
DEFECT_SOURCE_DB_USER=
DEFECT_SOURCE_DB_PASSWORD=
DEFECT_SOURCE_DB_SCHEMA=

# SQL Server 源库说明
# 常见示例：
# DEFECT_SOURCE_DB_TYPE=sqlserver
# DEFECT_SOURCE_DB_PORT=1433
# DEFECT_SOURCE_DB_SCHEMA=dbo
# 空密码请直接写成 DEFECT_SOURCE_DB_PASSWORD=
# 当前脚本使用 python-tds，不需要额外安装 Windows ODBC Driver

# 增量刷新配置
DEFECT_SUMMARY_BATCH_SIZE=2000
DEFECT_SUMMARY_REPLAY_HISTORY_WINDOW=500
DEFECT_SUMMARY_LOCK_KEY=20260413
DEFECT_SUMMARY_BOOTSTRAP_MODE=from_summary
DEFECT_SUMMARY_LOG_LEVEL=INFO
DEFECT_SUMMARY_TIMEZONE=Asia/Shanghai
